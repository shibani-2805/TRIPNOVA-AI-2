# Copy this file to ".env" and fill in your own values.
# The real ".env" file is ignored by Git, so your secrets stay private.

# REQUIRED for deployment: a long random string that protects login sessions.
# Create one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to true when the site is served over HTTPS (for example on Render).
COOKIE_SECURE=false

# Where the SQLite database file is stored (optional).
# DATABASE_PATH=tripnova.db

# Optional live data (no API key needed). Set to false to switch off.
USE_LIVE_WEATHER=true
USE_LIVE_RATES=true

# OPTIONAL real-AI feature ("AI trip brief"). Leave empty to keep it off.
# Get a key from https://console.anthropic.com/ (usage is billed by Anthropic).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
